<group name="honeypot,http,">

  <!-- Base: cada request HTTP. Nivel 2: cuenta para las reglas de frecuencia
       pero no llena el panel (log_alert_level = 3). -->
  <rule id="100340" level="2">
    <if_sid>100300</if_sid>
    <field name="honeypot_event">^http_request$</field>
    <description>Honeypot: request HTTP desde $(ip).</description>
  </rule>

  <!-- Exploit de GPON (Muhstik/Mirai): el comando viaja en el cuerpo del POST. -->
  <rule id="100341" level="8">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)GponForm/diag_Form</field>
    <description>Honeypot: intento de explotacion de router GPON desde $(ip).</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- Busqueda de proxy abierto: URL absoluta (GET http://...) o CONNECT host:puerto. -->
  <rule id="100342" level="5">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)^(https?://|[\w.\-]+:\d+$)</field>
    <description>Honeypot: busqueda de proxy abierto desde $(ip) hacia $(path).</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <!-- Handshake T3 de WebLogic (nmap weblogic-t3-info). Llega como "metodo" t3. -->
  <rule id="100343" level="5">
    <if_sid>100340</if_sid>
    <field name="method">^t3$</field>
    <description>Honeypot: sondeo de WebLogic T3 desde $(ip).</description>
    <mitre><id>T1595.002</id></mitre>
  </rule>

  <!-- Bytes que no son HTTP: handshake TLS, SOCKS, banners SSH, sondas propias de escaneres. -->
  <rule id="100344" level="3">
    <if_sid>100340</if_sid>
    <field name="method" type="pcre2">^(?!(GET|POST|HEAD|OPTIONS|PUT|DELETE|PATCH|CONNECT|t3)$)</field>
    <description>Honeypot: trafico que no es HTTP en el puerto web desde $(ip).</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <!-- Sondas a aplicaciones conocidas. -->
  <rule id="100345" level="5">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)(geoserver|wp-json|wp-login|xmlrpc\.php|/hudson|/jenkins|phpmyadmin|/\.env|/\.git|actuator|/solr|manager/html|/@vite/)</field>
    <description>Honeypot: sondeo de aplicacion web conocida ($(path)) desde $(ip).</description>
    <mitre><id>T1595.002</id></mitre>
  </rule>

  <!-- Sondeo de APIs de modelos de IA (OpenAI, Anthropic, Gemini, Ollama...): buscan
       endpoints abiertos para usar el modelo de otro sin pagar. Va antes de la rafaga
       y no se pisa con 100345 porque los patrones no se solapan. -->
  <rule id="100348" level="6">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)(/v1/(models|chat/completions|completions|embeddings|messages)|/v1beta/models|/api/(v1/)?models|/api/(tags|generate|chat)\b|/openai/v1|/ollama/)</field>
    <description>Honeypot: sondeo de API de modelos de IA ($(path)) desde $(ip).</description>
    <mitre><id>T1595.002</id></mitre>
  </rule>

  <!-- Sondeo de endpoints MCP (Model Context Protocol) o de streaming de eventos de agentes de IA:
       buscan servidores MCP mal expuestos a internet para abusar de sus herramientas.
       Visto el 20 de noviembre en los dos honeypots (/mcp, /mcp/, /sse, /api/mcp). -->
  <rule id="100349" level="6">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)^/(api/)?(mcp|sse)(/|\?|$)</field>
    <description>Honeypot: sondeo de endpoint MCP/agente de IA ($(path)) desde $(ip).</description>
    <mitre><id>T1595.002</id></mitre>
  </rule>

  <!-- Rafaga: muchos requests de la misma IP en poco tiempo. -->
  <rule id="100346" level="5" frequency="10" timeframe="120" ignore="300">
    <if_matched_sid>100340</if_matched_sid>
    <same_field>ip</same_field>
    <description>Honeypot: rafaga de requests HTTP desde $(ip).</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <!-- Exploit de routers Netgear (inyeccion de comando via syscmd en setup.cgi),
       tipico de botnets IoT tipo Mirai. Visto el 20 de noviembre en el honeypot principal. -->
  <rule id="100380" level="8">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)setup\.cgi\?.*todo=syscmd</field>
    <description>Honeypot: intento de explotacion de router Netgear (inyeccion de comando) desde $(ip).</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- Inyeccion de comando generica en routers y camaras: un parametro cmd/command/exec/shell que trae
       un descargador (wget, curl, tftp...). Caso real del 25/11: /board.cgi?cmd=cd+/tmp;rm+-rf+*;wget+http://.../Mozi.x
       (el nombre del archivo dice Mozi; que sea esa botnet es lectura mia). Va DESPUES de 100380 a proposito:
       entre hermanas gana la primera que coincide, asi el exploit de Netgear sigue cayendo en 100380 (mas especifica).
       Limite: solo mira el parametro en la URL, no el cuerpo de un POST.
       El & se escribe \x26 a proposito. La primera version con &amp; fallo en logtest del manager el 25/11 aunque pasaba
       el modelo offline del CI; mi hipotesis es que el parser de Wazuh no decodifica &amp; dentro de la clase de
       caracteres (sin verificar). \x26 funciona en los dos casos. -->
  <rule id="100384" level="8">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)[?\x26](cmd|command|exec|shell)=[^\x26\s]*(wget|curl|tftp|ftpget|busybox)\b</field>
    <description>Honeypot: inyeccion de comando con descarga en un parametro de la URL ($(path)) desde $(ip).</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- Sondeo de stagers "checksum8" (Metasploit / Cobalt Strike): rutas de 4 letras cuya suma ASCII da 92 o 93.
       Vistas: /aaa9, /aab8, /aab9, a diario en los dos honeypots. Que busquen un servidor de Cobalt Strike es una
       inferencia a partir de la coincidencia numerica, no una atribucion documentada. Lista fija de las rutas vistas
       (una regex no puede calcular la suma): otras rutas con la misma propiedad no salten. -->
  <rule id="100385" level="5">
    <if_sid>100340</if_sid>
    <field name="path" type="pcre2">(?i)^/(aaa9|aab8|aab9)/?([?#].*)?$</field>
    <description>Honeypot: sondeo de ruta checksum8 ($(path)) desde $(ip), posible busqueda de un stager de Cobalt Strike o Metasploit.</description>
    <mitre><id>T1595.002</id></mitre>
  </rule>

  <!-- FTP anonimo. -->
  <rule id="100347" level="4">
    <if_sid>100300</if_sid>
    <field name="honeypot_event">^ftp_login_attempt$</field>
    <field name="username" type="pcre2">(?i)^anonymous$</field>
    <description>Honeypot: login FTP anonimo desde $(ip).</description>
    <mitre><id>T1078</id></mitre>
  </rule>

</group>
